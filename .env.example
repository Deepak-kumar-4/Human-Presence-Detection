# Copy this file to .env and fill in real values. .env is gitignored.

# Gmail account used to send detection alert emails (requires an App Password)
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
# Comma-separated list of alert recipient email addresses
EMAIL_RECIPIENTS=

# Twilio account used to send detection alert SMS messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Comma-separated list of recipient phone numbers in E.164 format
SMS_RECIPIENTS=
